#. Plugin Name of the plugin
#: frontend-gatekeeper.php
#: frontend-gatekeeper.php:143
#: frontend-gatekeeper.php:144
#: frontend-gatekeeper.php:241
msgid "Frontend Gatekeeper"
msgstr "Frontend Gatekeeper"

#. Plugin URI of the plugin
#: frontend-gatekeeper.php
msgid "https://jdbg.com/frontend-gatekeeper/"
msgstr "https://jdbg.com/frontend-gatekeeper/"

#. Description of the plugin
#: frontend-gatekeeper.php
msgid "Hides the public frontend unless a configured URL parameter is present, then keeps that parameter on same-site links."
msgstr "Скрива публичната част на сайта, освен ако в адреса не присъства зададен параметър, след което запазва този параметър във вътрешните връзки."

#. Author of the plugin
#: frontend-gatekeeper.php
msgid "Jordan Hlebarov"
msgstr "Йордан Хлебаров"

#. Author URI of the plugin
#: frontend-gatekeeper.php
msgid "https://hwp.bg"
msgstr "https://hwp.bg"

#: frontend-gatekeeper.php:76
#: frontend-gatekeeper.php:282
msgid "On"
msgstr "Включено"

#: frontend-gatekeeper.php:77
#: frontend-gatekeeper.php:282
msgid "Off"
msgstr "Изключено"

#: frontend-gatekeeper.php:164
msgid "Access URL Parameter"
msgstr "Параметър за достъп в URL"

#: frontend-gatekeeper.php:166
msgid "Visitors can view the frontend only when the configured parameter and value are present in the URL."
msgstr "Посетителите могат да виждат сайта само когато зададените параметър и стойност присъстват в URL адреса."

#: frontend-gatekeeper.php:173
msgid "Enable frontend gate"
msgstr "Активиране на ограничението"

#: frontend-gatekeeper.php:181
msgid "Parameter name"
msgstr "Име на параметъра"

#: frontend-gatekeeper.php:189
msgid "Parameter value"
msgstr "Стойност на параметъра"

#: frontend-gatekeeper.php:197
msgid "Blocked message"
msgstr "Съобщение при блокиране"

#: frontend-gatekeeper.php:250
msgid "Access URL"
msgstr "URL за достъп"

#: frontend-gatekeeper.php:261
msgid "Copy to clipboard"
msgstr "Копирай"

#: frontend-gatekeeper.php:264
msgid "Copied!"
msgstr "Копирано!"

#: frontend-gatekeeper.php:283
msgid "Hide the public frontend unless the access URL parameter is present."
msgstr "Скриване на публичната част на сайта, освен ако в URL адреса не присъства параметърът за достъп."

#: frontend-gatekeeper.php:292
msgid "Use letters, numbers, and underscores. Example: fronga_access"
msgstr "Използвайте букви, цифри и долни черти. Пример: fronga_access"

#: frontend-gatekeeper.php:300
msgid "Example: preview-2026. Visitors would open the site with ?parameter_name=parameter_value."
msgstr "Пример: preview-2026. Посетителите ще отварят сайта с ?parameter_name=parameter_value."

